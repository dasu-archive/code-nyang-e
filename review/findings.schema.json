{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "code-nyang-e Claude review findings",
  "description": "Shape of claude -p structured_output. Same fields as claude.findings[] in the data contract, minus firstSeen (added from the ledger).",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "file", "line", "message"],
        "properties": {
          "category": { "enum": ["transaction", "concurrency", "scale", "failure", "other"] },
          "severity": { "enum": ["high", "medium", "low"] },
          "file": {
            "type": "string",
            "description": "Path relative to the target repo root, e.g. src/main/java/...",
            "pattern": "^[^/\\\\][^:]*$"
          },
          "line": { "type": ["integer", "null"], "minimum": 1, "description": "First line of the problem; null for a file-level finding." },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
